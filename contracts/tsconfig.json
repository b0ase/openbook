{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "outDir": "dist",
    // The app's own path alias, so the boundary tests can import app modules
    // written idiomatically. Nothing in src/ here uses it — the dependency runs
    // ONE WAY, tests reaching into the app, never the app reaching in here.
    "baseUrl": ".",
    "paths": { "@/*": ["../src/*"] },
    "plugins": [{ "transform": "scrypt-ts-transpiler" }]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
