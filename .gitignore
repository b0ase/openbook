# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
local.db
local.db-wal
local.db-shm

# Genesis seed: commit the DB itself (seed/genesis.db) but never its WAL sidecars
seed/genesis.db-wal
seed/genesis.db-shm

# claude code local config
.claude/

certificates
# Local debugging dumps (browser console exports, etc.) — never commit
console
console.*
*.console.log

# Key material — belt and braces. Nothing here should ever exist inside the repo,
# but a stray copy must not be committable. WIFs are spendable secrets.
*server-key*.txt
*.wif
*keypair*.txt
openbook-server-key*

# Uploaded media — lives on the persistent volume in production (UPLOAD_PATH),
# and beside local.db in development. Never committed.
uploads/

# Editor workspace files. They hold LOCAL FILESYSTEM PATHS to other projects on
# the author's machine — exactly the incidental leakage Hard Rule #6 is about,
# since repo files are public and effectively permanent. A `git add -A` will
# sweep one up if it is not ignored, which is how it nearly got committed.
*.code-workspace
